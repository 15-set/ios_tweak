#!/bin/sh
# 安装后: 注册内置 ChargeLimiterDaemon（不再安装/打开桌面 ChargeLimiter.app）
# 注意: 若作业已在运行则保持不动，避免升级时打断正在使用的充电控制。
set +e

JBROOT=""
[ -d /var/jb ] && JBROOT="/var/jb"

DAEMON="$JBROOT/usr/libexec/insulation/ChargeLimiterDaemon"
LANGJSON="$JBROOT/usr/libexec/insulation/lang.json"
PLISTDIR="$JBROOT/Library/LaunchDaemons"
PLIST="$PLISTDIR/com.chargelimiter.mod.plist"

# 1) 可执行位兜底
chmod 755 "$DAEMON" 2>/dev/null
chmod 644 "$LANGJSON" 2>/dev/null

# 2) 数据目录（rootless 下路径带 /var/jb 前缀，daemon 通过 libroot 解析）
mkdir -p "$JBROOT/var/mobile/Library/Preferences" 2>/dev/null
mkdir -p "$JBROOT/var/mobile/Library/Application Support/ChargeLimiter" 2>/dev/null
mkdir -p "$JBROOT/var/mobile/ChargeLimiter" 2>/dev/null
chown mobile:mobile "$JBROOT/var/mobile/ChargeLimiter" 2>/dev/null
chown -R mobile:mobile "$JBROOT/var/mobile/Library/Application Support/ChargeLimiter" 2>/dev/null

# 3) 生成 launchd plist（Program 路径按 rootless/rootful 实际位置写入）
mkdir -p "$PLISTDIR" 2>/dev/null
cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.chargelimiter.mod</string>
	<key>Program</key>
	<string>$DAEMON</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>EnvironmentVariables</key>
	<dict>
		<key>DYLD_LIBRARY_PATH</key>
		<string>$JBROOT/usr/lib:/usr/lib</string>
		<key>DYLD_FALLBACK_LIBRARY_PATH</key>
		<string>$JBROOT/usr/lib:/usr/lib</string>
	</dict>
</dict>
</plist>
EOF
chmod 644 "$PLIST" 2>/dev/null

# 4) 已在运行则保持不动；未运行才引导
for lc in "$JBROOT/usr/bin/launchctl" /usr/bin/launchctl /bin/launchctl; do
    [ -x "$lc" ] || continue
    if "$lc" print system/com.chargelimiter.mod >/dev/null 2>&1; then
        break
    fi
    "$lc" bootstrap system "$PLIST" >/dev/null 2>&1 || "$lc" load -w "$PLIST" >/dev/null 2>&1
    break
done

exit 0
