<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<!-- ===== 原有 cell, 与 deb 内 Root.plist (binary plist 解码) 逐项一致 ===== -->
		<dict>
			<key>label</key>
			<string>CPU</string>
			<key>cell</key>
			<string>PSGroupCell</string>
		</dict>
		<dict>
			<key>validValues</key>
			<array>
				<string>off</string>
				<string>lowPower</string>
				<string>fullPower</string>
			</array>
			<key>validTitles</key>
			<array>
				<string>苹果原生温控</string>
				<string>模拟低电频率</string>
				<string>防止温控降频</string>
			</array>
			<key>defaults</key>
			<string>com.be-huge.insulation-prefs</string>
			<key>cell</key>
			<string>PSLinkListCell</string>
			<key>label</key>
			<string>CPU 模式</string>
			<key>key</key>
			<string>thermalPowerMode</string>
			<key>PostNotification</key>
			<string>com.be-huge.insulation-executePuppetEvent</string>
			<key>default</key>
			<string>off</string>
		</dict>
		<dict>
			<key>label</key>
			<string>屏幕</string>
			<key>cell</key>
			<string>PSGroupCell</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>防止温控暗屏</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.be-huge.insulation-prefs</string>
			<key>key</key>
			<string>thermalPreventDimmingEnabled</string>
		</dict>
		<dict>
			<key>label</key>
			<string>高级功能</string>
			<key>cell</key>
			<string>PSGroupCell</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>禁温度计弹窗</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.be-huge.insulation-prefs</string>
			<key>key</key>
			<string>thermalSuppressNotificationsEnabled</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>禁用口袋高温</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.be-huge.insulation-prefs</string>
			<key>key</key>
			<string>thermalDisablePocketSunlightEnabled</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>锁定阳光暴晒</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.be-huge.insulation-prefs</string>
			<key>key</key>
			<string>thermalSunlightLockedEnabled</string>
		</dict>

		<!-- ===== [NEW] 电池原生温控 (单一开关, 无阈值/无回差) ===== -->
		<dict>
			<key>label</key>
			<string>电池</string>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>打开：电池温控永久交还系统原生策略（不区分充电状态、不比较温度、无阈值与回差）。关闭：完全恢复插件原本行为。无论开关如何设置，CPU 均不会被温控降频。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>电池原生温控</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.be-huge.insulation-prefs</string>
			<key>key</key>
			<string>chragingBatteryThermalProtect</string>
			<key>PostNotification</key>
			<string>com.be-huge.insulation-batteryProtectChanged</string>
		</dict>

		<!-- ===== [NEW] 充电原生温控: 独立开关, 只按「是否插线」切换, 不比较温度/无阈值/无回差 ===== -->
		<dict>
			<key>label</key>
			<string>充电保护</string>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>打开：检测到充电（插着电源）时，本插件全部原有温控功能立即失效，回到系统原生温控；拔掉充电器后自动恢复你上面设置的全部功能。关闭：完全不影响原有逻辑，插件照常运行。此开关独立生效，可随时手动开关。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>充电原生温控开关</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.be-huge.insulation-prefs</string>
			<key>key</key>
			<string>chargingNativeThermalEnabled</string>
			<key>PostNotification</key>
			<string>com.be-huge.insulation-chargeNativeChanged</string>
		</dict>
	</array>
	<key>title</key>
	<string>Insulation</string>
</dict>
</plist>
