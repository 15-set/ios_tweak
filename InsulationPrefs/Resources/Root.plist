<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<!-- ===== 原有 cell, 与 deb 内 Root.plist (binary plist 解码) 逐项一致 ===== -->
		<dict>
			<key>label</key>
			<string>CPU</string>
			<key>cell</key>
			<string>PSGroupCell</string>
		</dict>
		<dict>
			<key>validValues</key>
			<array>
				<string>off</string>
				<string>lowPower</string>
				<string>fullPower</string>
			</array>
			<key>validTitles</key>
			<array>
				<string>苹果原生温控</string>
				<string>模拟低电频率</string>
				<string>防止温控降频</string>
			</array>
			<key>defaults</key>
			<string>com.be-huge.insulation-prefs</string>
			<key>cell</key>
			<string>PSLinkListCell</string>
			<key>label</key>
			<string>CPU 模式</string>
			<key>key</key>
			<string>thermalPowerMode</string>
			<key>PostNotification</key>
			<string>com.be-huge.insulation-executePuppetEvent</string>
			<key>default</key>
			<string>off</string>
		</dict>
		<dict>
			<key>label</key>
			<string>屏幕</string>
			<key>cell</key>
			<string>PSGroupCell</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>防止温控暗屏</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.be-huge.insulation-prefs</string>
			<key>key</key>
			<string>thermalPreventDimmingEnabled</string>
		</dict>
		<dict>
			<key>label</key>
			<string>高级功能</string>
			<key>cell</key>
			<string>PSGroupCell</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>禁温度计弹窗</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.be-huge.insulation-prefs</string>
			<key>key</key>
			<string>thermalSuppressNotificationsEnabled</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>禁用口袋高温</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.be-huge.insulation-prefs</string>
			<key>key</key>
			<string>thermalDisablePocketSunlightEnabled</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>锁定阳光暴晒</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.be-huge.insulation-prefs</string>
			<key>key</key>
			<string>thermalSunlightLockedEnabled</string>
		</dict>

		<!-- ===== [NEW] 充电电池温控保护 ===== -->
		<dict>
			<key>label</key>
			<string>充电电池温控保护</string>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>充电时监测电池温度，达到设定温度后交由原生电池温控接管保护；仅释放电池温控，CPU 不降频功能不受影响；温度回落 2℃ 后恢复插件控制。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>充电电池温控保护</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.be-huge.insulation-prefs</string>
			<key>key</key>
			<string>chragingBatteryThermalProtect</string>
			<key>PostNotification</key>
			<string>com.be-huge.insulation-batteryProtectChanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
			<string>充电电池控温阈值 (℃)</string>
			<key>default</key>
			<string>45</string>
			<key>defaults</key>
			<string>com.be-huge.insulation-prefs</string>
			<key>key</key>
			<string>chargingBatteryTempThreshold</string>
			<key>keyboard</key>
			<string>numbers</string>
			<key>isNumeric</key>
			<string>true</string>
			<key>placeholder</key>
			<string>35~50 的整数，默认 45</string>
			<key>PostNotification</key>
			<string>com.be-huge.insulation-batteryProtectChanged</string>
		</dict>
	</array>
	<key>title</key>
	<string>Insulation</string>
</dict>
</plist>
